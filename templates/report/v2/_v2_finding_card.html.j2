{# ==========================================================================
   Security License Lens — v2 finding article (expanded belief block)

   Renders ONE finding article from the v2 view-model payload built by
   src/licenselens/report/viewmodel.py. The body is the six-slot belief block
   from build_belief_block(finding, capability_summaries, expected_by_check_id)
   with progressive disclosure per DESIGN_V2.md section 8: the summary line and
   slots 1-2 (Expected / Observed) first, slots 3-4 (Why it matters / Recommended
   action) next, then the technical evidence inside a native
   <details class="tech"> disclosure.

   This article is the expanded body of the merged Findings section's collapsed
   <details class="explore-row"> row — one row per finding, collapsed by default;
   expanding the row reveals this block.

   Include contract (consumed by both the single-file and bundle renderers):
     - `block` — one dict from build_sections(result)["D"], ordered the same
       as result.findings. Keys: expected (str, catalog expected_state for the
       check id, "Not reported" when unmapped), summary_line (str, the finding
       customer_summary — omitted entirely when empty), observed (summary +
       evidence), why_it_matters (capability / severity / value_impact /
       blast_radius), recommended_action (str), evidence (data_sources /
       confidence_label / limitations), admin_destination (str | None).
      - `f` — the paired serialized finding from build_sections(result)["E"]
        ["findings"] at the same index (see _finding_entry in viewmodel.py).
        Supplies the article's id, data-status / data-workload / data-check-id
        and facet attributes, the status marker, the title, the head meta
        row, and the Observed slot prose (f.summary). The summary line and the
        remaining belief slots bind strictly to `block`, never to hardcoded
        copy.
      - Skipped findings (f.status == "skipped", the "Not assessed" marker)
        are rendered unassessed, never as if they were evaluated: the meta
        row annotates Severity with "(potential impact — not yet assessed)"
        and omits Confidence and Evaluation (there was no evaluation); the
        Observed slot is replaced by a "Why this was skipped" slot bound to
        block.skip_reason (the check's own manual / insufficient-evidence /
        environment-specific rationale, built by build_skip_reason in
        viewmodel.py). Non-skipped findings are unchanged.
      - `prim` — imported below from report/v2/_v2_primitives.html.j2.

   Deep-linking contract (DESIGN_V2.md Findings section): the article carries
   id="finding-<check_id>"; `#finding-<check_id>` opens the parent row,
   selects, reveals, and scrolls to it. The only external URL rendered is
   block.admin_destination (the Microsoft admin deep link); no <img>, no
   emoji, no literal slot values.
   ========================================================================== #}
{%- import "report/v2/_v2_primitives.html.j2" as prim -%}
{%- set _skipped = f.status == 'skipped' -%}
     <article class="finding {{ f.status }}" id="finding-{{ f.check_id }}" data-status="{{ f.status }}" data-workload="{{ f.workload }}" data-check-id="{{ f.check_id }}" data-severity="{{ f.severity }}" data-confidence="{{ f.confidence }}" data-mode="{{ f.evaluation_mode }}" data-pack="{{ f.pack }}">
       <div class="finding-head">
         {{ prim.status_marker(f.status) }}
         <h3>{{ f.title }}</h3>
       </div>
       <div class="finding-meta">
         {% if f.severity %}<span class="meta-item"><span class="meta-key">Severity:</span> {{ f.severity | capitalize }}{% if _skipped %} <span class="meta-note">(potential impact — not yet assessed)</span>{% endif %}</span>{% endif %}
         {% if f.effort_label %}<span class="meta-item"><span class="meta-key">Effort:</span> {{ f.effort_label }}</span>{% endif %}
         {% if f.blast_radius %}<span class="meta-item"><span class="meta-key">Scope:</span> {{ exec_copy["scope"].get(f.blast_radius, f.blast_radius | replace('_', ' ')) }}</span>{% endif %}
         {% if f.workload %}<span class="meta-item"><span class="meta-key">Workload:</span> {{ f.workload | capitalize }}</span>{% endif %}
         {% if not _skipped %}{% if f.confidence_label %}<span class="meta-item"><span class="meta-key">Confidence:</span> {{ f.confidence_label }}</span>{% endif %}{% endif %}
         {% if not _skipped %}{% if f.evaluation_mode %}<span class="meta-item"><span class="meta-key">Evaluation:</span> {{ exec_copy["evaluation_mode"].get(f.evaluation_mode, f.evaluation_mode | replace('_', ' ')) }}</span>{% endif %}{% endif %}
       </div>

      {# Progressive disclosure level 1: the executive summary line, before the
         slots. Bound to block.summary_line (finding.customer_summary) and
         omitted entirely when empty. #}
      {% if block.summary_line %}<p class="finding-summary">{{ block.summary_line }}</p>{% endif %}

      <div class="belief-slot">
        <span class="belief-label">Expected</span>
        <p>{{ block.expected or "Not reported" }}</p>
      </div>

      {% if _skipped %}
      {# A skipped finding was never assessed: instead of an "Observed"
         sentence there is the check's own skip rationale (manual check,
         insufficient evidence, environment-specific — whatever the producer
         authored), bound to block.skip_reason. #}
      <div class="belief-slot">
        <span class="belief-label">Why this was skipped</span>
        <p>{{ block.skip_reason or "Not reported" }}</p>
      </div>
      {% else %}
      <div class="belief-slot">
        <span class="belief-label">Observed</span>
        {% if f.summary %}
        <p>{{ f.summary }}</p>
        {% else %}
        <p>Not reported</p>
        {% endif %}
      </div>
      {% endif %}

      {# Progressive disclosure level 2: why it matters + recommended action. #}
      <div class="belief-slot">
        <span class="belief-label">Why it matters</span>
        <p>{{ block.why_it_matters.capability or "Not reported" }}</p>
        <div class="belief-meta">
          {# Severity and Scope already appear once in the header meta row;
             this slot keeps only the value impact (the meta single-source rule). #}
          <span class="meta-item"><span class="meta-key">Value impact:</span> {{ exec_copy["value_impact"].get(block.why_it_matters.value_impact, block.why_it_matters.value_impact | replace('_', ' ')) }}</span>
        </div>
      </div>

      <div class="belief-slot">
        <span class="belief-label">Recommended action</span>
        <p>{{ block.recommended_action or "Not reported" }}</p>
      </div>

      {# Progressive disclosure level 3: technical evidence, inside the
         native <details class="tech"> disclosure — data sources, limitations,
         and the evidence keys. #}
      <div class="belief-slot">
        <span class="belief-label">Evidence</span>
        <details class="tech">
          <summary><span class="caret" aria-hidden="true">▸</span> Technical evidence</summary>
          <div class="tech-body">
            {# Confidence already appears once in the header meta row. #}
            <p><strong>Data sources:</strong> {{ block.evidence.data_sources | join(', ') or 'Not reported' }}</p>
            {% if block.observed.evidence %}
            <ul class="evidence-keys">
              {% for key, value in block.observed.evidence.items() -%}
              {%- set empty = value is none or (value is string and value == '') or (value is sequence and value is not string and value | length == 0) or (value is mapping and value | length == 0) -%}
              <li><code>{{ key }}</code>: {% if empty %}None reported{% elif value is mapping -%}{{ value | tojson }}{%- elif value is sequence and value is not string -%}{{ value | join(', ') }}{%- else -%}{{ value }}{%- endif %}</li>
              {% endfor %}
            </ul>
            {% endif %}
            <p><strong>Limitations:</strong> {% if block.evidence.limitations %}{% for limit in block.evidence.limitations %}{{ limit.rstrip('.') }}{% if not loop.last %}; {% endif %}{% endfor %}{% else %}None reported{% endif %}</p>
          </div>
        </details>
      </div>

      {# The only external URL allowed: the Microsoft admin deep link. #}
      {% if block.admin_destination %}
      <div class="belief-slot">
        <span class="belief-label">Admin destination</span>
        <p><a href="{{ block.admin_destination }}">Open the admin page</a></p>
      </div>
      {% endif %}
    </article>
