{# ==========================================================================
   Security License Lens — v2 shared markup primitives (Jinja2 partial).

   Design identity: "SOC Dark" (DESIGN_V2.md, the binding v2 contract). This file is the
   single source of truth for status words and status glyph geometry; it is
   consumed by BOTH renderers via:

       {%- import "report/v2/_v2_primitives.html.j2" as prim -%}

   Contract notes enforced here (DESIGN_V2.md section 9, retained rules):
     - Every glyph is an inline 24x24-viewBox SVG at 14x14, painted with
       currentColor, aria-hidden="true" focusable="false", always rendered
       beside a visible text word (never icon-only).
     - No emoji, no image elements, no external or data-URI assets, no
       literal hex.
     - The six glyphs keep v1's locked geometry and stay pairwise distinct:
       gap = chevron-alert, partial = half-fill, ok = check-ring,
       not_licensed = slash-circle, skipped = dash, error = triangle-alert.
     - Status color is carried by the marker's class, mapped in CSS to the
       v2 state tokens (no color in markup): gap/error -> var(--state-action),
       partial -> var(--state-incomplete), ok -> var(--state-ok),
       not_licensed/skipped -> var(--state-neutral).
   ========================================================================== #}

{%- set PRESENTATION = {
    'gap': 'Action required',
    'partial': 'Incomplete',
    'ok': 'Operational',
    'not_licensed': 'Not licensed',
    'skipped': 'Not assessed',
    'error': 'Verification failed',
} -%}

{# Capability-outcome statuses (section B vocabulary) map onto the same
   finding variants and presentation words. #}
{%- set CAPABILITY_PRESENTATION = {
    'needs_attention': 'Action required',
    'partly_set_up': 'Incomplete',
    'fully_working': 'Operational',
    'assessment_incomplete': 'Not assessed',
    'not_licensed': 'Not licensed',
} -%}

{%- set CAPABILITY_VARIANT = {
    'needs_attention': 'gap',
    'partly_set_up': 'partial',
    'fully_working': 'ok',
    'assessment_incomplete': 'skipped',
    'not_licensed': 'not_licensed',
} -%}

{%- macro status_glyph(variant) -%}
{%- if variant == 'gap' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4 4h7v3H7v10h4v3H4V4zm9 0 7 8-7 8v-5h-4v-6h4V4z"/></svg>
{%- elif variant == 'partial' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4 4h16v16H4V4zm3 3v10h5V7H7z"/><path fill="none" stroke="currentColor" stroke-width="2" d="M4 4h16v16H4z"/></svg>
{%- elif variant == 'ok' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M7.5 12.5 10.5 15.5 16.5 9"/></svg>
{%- elif variant == 'not_licensed' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M8 8l8 8"/></svg>
{%- elif variant == 'skipped' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M6 12h12"/></svg>
{%- else -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 3 22 20H2L12 3zm0 5.5c-.7 0-1.2.6-1.1 1.3l.5 5.2h1.2l.5-5.2c.1-.7-.4-1.3-1.1-1.3zM12 18.2a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2z"/></svg>
{%- endif -%}
{%- endmacro -%}


{%- macro lens_mark() -%}
{# Camera-lens identity mark. Decorative. currentColor = --accent on screen,
   --accent-print on paper. No xmlns (single-file forbids http://). Front rim
   is ~30% wider than the barrel so the silhouette reads as a lens, not a cup. #}
<svg class="lens-mark" viewBox="0 0 64 72" width="40" height="45" aria-hidden="true" focusable="false" fill="none">
  <path class="lens-mark__body" d="M11 26 L11 58 C11 64 53 64 53 58 L53 26 Z"/>
  <path class="lens-mark__band" d="M11.5 34 H52.5 V46 H11.5 Z"/>
  <g class="lens-mark__hashes" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <line x1="18.2" y1="36.2" x2="18.2" y2="43.8"/>
    <line x1="22.0" y1="36.2" x2="22.0" y2="43.8"/>
    <line x1="25.8" y1="36.2" x2="25.8" y2="43.8"/>
    <line x1="29.6" y1="36.2" x2="29.6" y2="43.8"/>
    <line x1="33.4" y1="36.2" x2="33.4" y2="43.8"/>
    <line x1="37.2" y1="36.2" x2="37.2" y2="43.8"/>
    <line x1="41.0" y1="36.2" x2="41.0" y2="43.8"/>
    <line x1="44.8" y1="36.2" x2="44.8" y2="43.8"/>
  </g>
  <path class="lens-mark__stroke" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" d="M11 26 L11 58 C11 64 53 64 53 58 L53 26"/>
  <ellipse class="lens-mark__stroke" cx="32" cy="58" rx="21" ry="6.2" stroke="currentColor" stroke-width="2.5"/>
  <path class="lens-mark__stroke" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M11 34 H53"/>
  <path class="lens-mark__stroke" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M11 46 H53"/>
  <ellipse class="lens-mark__body" cx="32" cy="18" rx="28" ry="11"/>
  <ellipse class="lens-mark__stroke" cx="32" cy="18" rx="28" ry="11" stroke="currentColor" stroke-width="2.5"/>
  <ellipse class="lens-mark__glass" cx="32" cy="18" rx="16" ry="6" stroke="currentColor" stroke-width="1.9"/>
  <path class="lens-mark__stroke" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" d="M20 16 C24 13.2 40 13.2 44 16"/>
</svg>
{%- endmacro -%}

{%- macro status_marker(status) -%}
  {%- if status in PRESENTATION -%}
    {%- set variant = status -%}
    {%- set word = PRESENTATION[status] -%}
  {%- else -%}
    {%- set variant = CAPABILITY_VARIANT.get(status, status) -%}
    {%- set word = CAPABILITY_PRESENTATION.get(status, status) -%}
  {%- endif -%}
<span class="status-marker {{ variant }}">{{ status_glyph(variant) }}{{ word }}</span>
{%- endmacro -%}
