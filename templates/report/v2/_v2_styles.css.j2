/* ==========================================================================
   Security License Lens — v2 report foundation stylesheet
   Design identity: "SOC Dark" (DESIGN_V2.md, the binding v2 contract).

   This file is a Jinja2 partial: it is included inside an existing
   <style> block by both the single-file and bundle renderers, so it must
   never carry a <style> wrapper of its own.

   Contract notes enforced here (DESIGN_V2.md section numbers):
     - §2: Every color is a declared token; the only literal hex values in
       this file live inside the :root block. The two pinned tonal gradients
       and the single nav blur are tokens, never ad-hoc.
     - §3: locked type scale (2rem display, 3.5rem hero figure, 1rem body,
       tabular numerals on every metric figure); mono only for technical
       values; uppercase only via .micro-label (kickers, group captions).
     - §4: spacing is a multiple of 4; radius stops 0 / 2 / 6 / 10 / 16 and
       999px (pill) — pill ONLY for proportion-based fills and the
       constellation node circles; elevation is selective (shadows are
       state); layout uses logical properties only.
     - §11: motion is information design, gated behind body.revealed (JS
       opt-in). Only transform / opacity / stroke-dashoffset / color-resolve
       animate; nothing loops; nothing animates on scroll or input.
       prefers-reduced-motion = instant final state, zero information loss.
     - §13/§14: status is never color-only (glyph + word + color); focus
       rings, target sizes, forced-colors support.
     - §15: print is the light inversion with expanded disclosures and
       visible textual chart equivalents.
   ========================================================================== */

/* --------------------------------------------------------------------------
   §2. Token palette — declared once, referenced by name everywhere else.
   -------------------------------------------------------------------------- */
:root {
  /* §2.1 Screen tokens (dark-first, cool) */
  --canvas: #0B0E14;
  --surface-1: #131720;
  --surface-2: #1A2029;
  --surface-3: #212A35;
  --surface-4: #2A3542;
  --border: #232D38;
  --border-strong: #33404E;
  --text-1: #EDF2F7;
  --text-2: #B6C2CF;
  --text-3: #7D8FA3;
  --accent: #22D3EE;
  --accent-hover: #67E8F9;
  --accent-focus: #A5F3FC;
  --accent-print: #155E75;
  --state-action: #F87171;
  --state-incomplete: #F59E0B;
  --state-ok: #22C55E;
  --state-neutral: #94A3B8;
  --grad-hero: linear-gradient(165deg, #1A2330 0%, var(--surface-1) 55%, var(--canvas) 100%);
  --grad-raised: linear-gradient(180deg, var(--surface-3) 0%, var(--surface-2) 100%);
  --shadow-1: 0 1px 2px rgba(0,0,0,.35), 0 1px 4px rgba(0,0,0,.25);
  --shadow-2: 0 2px 6px rgba(0,0,0,.4), 0 8px 20px rgba(0,0,0,.35);
  --shadow-3: 0 4px 12px rgba(0,0,0,.45), 0 16px 40px rgba(0,0,0,.4);
  --blur-nav: blur(8px);

  /* §2.2 Print tokens (light inversion) */
  --print-ink: #1A2230;
  --print-paper: #FFFFFF;
  --print-hero: #EEF2F6;
  --print-border: #C6D0DA;
  --print-border-strong: #7E8B99;
  --print-action: #B02A37;
  --print-incomplete: #7A5000;
  --print-ok: #1B6B3F;
  --print-neutral: #4A5661;

  /* §3. Typography — system-only, offline-safe stacks (locked values). */
  --font-sans: "Segoe UI Variable Text", "Segoe UI", ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

/* --------------------------------------------------------------------------
   Base — canvas, page chrome, layout container.
   -------------------------------------------------------------------------- */
* { box-sizing: border-box; }

html { background: var(--canvas); }

body {
  margin: 0;
  background: var(--canvas);
  color: var(--text-1);
  font-family: var(--font-sans);
  font-size: 1rem; /* §3 body scale, locked */
  line-height: 1.6;
}

[hidden] { display: none !important; }

/* Masthead chrome: open on the canvas, radius 0 (§4). The header is
   box-aligned with main (same 1160px border-box + 32px gutters) so the
   masthead column matches the sections' 1096px content column. */
header {
  max-width: 1160px;
  margin-block: 0 24px;
  margin-inline: auto;
  padding-inline: 32px;
  background: transparent;
  border: 0;
  border-radius: 0;
}

/* The single bounded report container (exactly one main element). */
main {
  max-width: 1160px;
  margin-block: 0;
  margin-inline: auto;
  padding-inline: 32px;
}

/* --------------------------------------------------------------------------
   §3. Typography — locked type scale, heading hierarchy h1 -> h2 -> h3.
   -------------------------------------------------------------------------- */
h1 { font-size: 2rem; font-weight: 650; line-height: 1.25; }
h2 { font-size: 1.25rem; font-weight: 600; line-height: 1.3; }
h3 { font-size: 1.06rem; font-weight: 600; line-height: 1.35; }

/* Display: the signature opening line, a <p> (never a heading). */
.display-line {
  margin-block: 0;
  font-size: 2rem;
  font-weight: 650;
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: var(--text-1);
}

/* Hero figure: the ONE dominant metric (§5A). Accent identity color. */
.posture-figure {
  margin-block: 24px 0;
  font-size: 3.5rem;
  font-weight: 650;
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
  color: var(--accent);
}

/* Metric figure (secondary) — supporting stats, always tabular numerals. */
.metric-figure-secondary {
  font-size: 1.75rem;
  font-weight: 600;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

/* Label / micro-label / caption roles. */
.label {
  font-size: 0.8125rem;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-2);
}

.micro-label {
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.03em;
  text-transform: uppercase; /* kickers and group captions only (§3) */
  color: var(--text-2);
}

.caption { color: var(--text-3); }

/* Section kicker (micro-label role) and section help copy. */
.section-kicker { margin-block: 0 4px; }
.section-help { color: var(--text-2); margin-block: 4px 16px; }

/* Technical disclosure inner titles (h3, never headings for the
   disclosure itself). */
.tech-title { margin-block: 16px 8px; }
.tech-body { margin-block: 12px 4px; }
.tech-body p { margin-block: 8px 0; }

/* Numeral rules: mono stack for ids and numeric columns, numbers align end. */
.mono { font-family: var(--font-mono); }
.token { font-family: var(--font-mono); overflow-wrap: anywhere; }
.num {
  text-align: end;
  font-variant-numeric: tabular-nums;
}

/* Long unbroken values — finding titles, tenant names, organization ids —
   must wrap at any width instead of overflowing (narrow-width guard). */
h3,
code,
p,
.meta,
.finding-meta,
.card-title,
.mono {
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* Prose blocks never run full column width at desktop (§3). */
p { max-width: 72ch; }

/* --------------------------------------------------------------------------
   §2.3 Identity accent — links, selection, focus rings. Accent never colors
   a semantic status and never colors chart data.
   -------------------------------------------------------------------------- */
a { color: var(--accent); text-decoration: underline; }
a:hover { color: var(--accent-hover); }

::selection {
  background: var(--accent);
  color: var(--canvas);
}

/* Focus ring: 2px accent outline + 2px offset on every interactive element. */
:focus-visible {
  outline: 2px solid var(--accent-focus);
  outline-offset: 2px;
}

/* --------------------------------------------------------------------------
   §4. Surfaces and boundaries — canvas -> surface-1 -> ... -> surface-4.
   Whitespace and rules bound sections; cards only where a bounded unit
   earns one; shadows are state, never decoration.
   -------------------------------------------------------------------------- */
section {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: 0;
  padding-block: 24px;
  padding-inline: 32px;
}

section + section { margin-block-start: 24px; }

/* Hero: pinned tonal wash + hero shadow, 16px radius (§4). */
.hero {
  background: var(--grad-hero);
  box-shadow: var(--shadow-3);
  border-radius: 16px;
  padding-block: 32px;
  padding-inline: 40px;
}

/* Cards at rest have NO shadow (§4). */
.card {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding-block: 20px;
  padding-inline: 20px;
}

/* The single authorized blur: the bundle's sticky contextual nav (§2.3,
   opaque --surface-3 fallback). */
.context-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--surface-3);
  box-shadow: var(--shadow-2);
}
@supports (backdrop-filter: blur(1px)) {
  .context-nav { backdrop-filter: var(--blur-nav); }
}

/* --------------------------------------------------------------------------
   §2.3 Semantic mapping — status is never color-only; the word and glyph
   carry it. Error shares the gap color on screen and in print.
   -------------------------------------------------------------------------- */
.status-gap,
.status-error { color: var(--state-action); --resolve-to: var(--state-action); }
.status-partial { color: var(--state-incomplete); --resolve-to: var(--state-incomplete); }
.status-ok { color: var(--state-ok); --resolve-to: var(--state-ok); }
.status-not_licensed,
.status-skipped { color: var(--state-neutral); --resolve-to: var(--state-neutral); }

/* Status marker: the status_marker macro emits `class="status-marker <variant>"`
   (two classes), so the variant color must target the pair — the single-class
   selectors above color only the constellation cores and legend swatches. */
.status-marker {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.8125rem;
  font-weight: 600;
}
.status-glyph { flex-shrink: 0; }
.status-marker.gap,
.status-marker.error { color: var(--state-action); }
.status-marker.partial { color: var(--state-incomplete); }
.status-marker.ok { color: var(--state-ok); }
.status-marker.not_licensed,
.status-marker.skipped { color: var(--state-neutral); }

/* Finding status rails: 3px accent-free status color on the inline-start
   edge. Gap and error share the action rail. */
.finding {
  border-inline-start: 3px solid transparent;
}
.finding.gap,
.finding.error { border-inline-start-color: var(--state-action); }
.finding.partial { border-inline-start-color: var(--state-incomplete); }
.finding.ok { border-inline-start-color: var(--state-ok); }
.finding.not_licensed,
.finding.skipped { border-inline-start-color: var(--state-neutral); }

/* --------------------------------------------------------------------------
   §8. Progressive disclosure — native <details>, zero-JS. Closed = dashed
   rule on the primary surface; open = solid raised pane with the key
   shadow. Caret rotates 90° on open.
   -------------------------------------------------------------------------- */
details.tech {
  background: var(--surface-1);
  border: 1px dashed var(--border);
  border-radius: 0;
  padding-inline: 12px;
}
details.tech[open] {
  background: var(--surface-3);
  border: 1px solid var(--border-strong);
  box-shadow: var(--shadow-1);
}
details.tech summary {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-weight: 600;
  color: var(--text-2);
}
details.tech summary .caret { transition: transform 150ms ease-out; }
details.tech[open] summary .caret { transform: rotate(90deg); }
details.tech[open] > .tech-body { animation: fade-in 150ms ease-out both; }

/* --------------------------------------------------------------------------
   §7. Constellation — deterministic field, grouped by workload.
   Group captions are buttons (cross-filter); nodes are buttons (capability
   selection); status color + glyph + always-visible label, never color-only.
   The field carries ONLY the group columns; the status legend is a sibling
   block below it (see `.constellation-legend`) — never a grid column.
   Desktop: auto-fill wrap with a 160px column floor so no caption ever
   squeezes below its text width at 1280px; ≤640px the field becomes a
   single-row column flow that scrolls horizontally inside itself.
   -------------------------------------------------------------------------- */
.constellation {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 16px;
  overflow-x: auto;
  padding-block: 12px;
  margin-block: 8px 16px;
  scrollbar-color: var(--surface-4) transparent;
}

.constellation-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  border: 1px solid transparent;
  border-radius: 16px; /* §4: constellation group container */
  transition: border-color 150ms ease-out, box-shadow 150ms ease-out, background-color 150ms ease-out;
}
.constellation-group.is-selected {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-1);
  background: var(--surface-2);
}

/* Caption: brand icon + plain name, a real button (§7). */
.constellation-caption {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-block: 0 4px;
  padding: 0;
  border: none;
  background: none;
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--text-2);
  cursor: pointer;
}
.constellation-caption:hover { color: var(--text-1); }
.constellation-caption .workload-icon { width: 18px; height: 18px; }

/* Branded Microsoft workload marks (§12). Decorative only: the visible text
   label always accompanies them. Shared by the inline <svg> markup and the
   bundle's hashed image assets. */
.workload-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  vertical-align: middle;
  display: inline-block;
}

/* Node: 16×16 circle (pill radius authorized for this proportion-free
   decorative fill), 2px status ring + soft tinted fill, always-visible
   label. The base block declares NO color: the shared `.status-*` classes
   carry the static status color (server-side, zero JS); the reveal
   animation runs neutral -> `--resolve-to` (status) under `body.revealed`. */
.constellation-point {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px;
  border: none;
  background: none;
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  line-height: 1.4;
  text-align: start;
  cursor: pointer;
}

.constellation-core {
  position: relative;
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  border: 2px solid currentColor;
  border-radius: 999px;
}
.constellation-core::before {
  content: "";
  position: absolute;
  inset: 2px;
  border-radius: 999px;
  background: currentColor;
  opacity: 0.25;
}

/* Selected node: 3px accent ring outside; the status ring stays on the
   inner edge so status is never lost (§10). */
.constellation-point.is-selected .constellation-core {
  box-shadow: 0 0 0 1px var(--canvas), 0 0 0 3px var(--accent);
}

.constellation-label { color: var(--text-2); }

.constellation-legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 16px;
  /* Sibling block BELOW the field (todo 5): the negative block-start margin
     closes the field's own bottom margin so the two read as one unit. */
  margin-block: -8px 16px;
}
.constellation-legend-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.75rem;
  color: var(--text-2);
}
/* Legend swatches carry the status color via two-class rules: the single-
   class `.status-*` selectors are beaten by the chip base block above
   (same specificity, later in source), so the pair must target both. */
.constellation-legend-chip.status-gap,
.constellation-legend-chip.status-error { color: var(--state-action); }
.constellation-legend-chip.status-partial { color: var(--state-incomplete); }
.constellation-legend-chip.status-ok { color: var(--state-ok); }
.constellation-legend-chip.status-not_licensed,
.constellation-legend-chip.status-skipped { color: var(--state-neutral); }
.constellation-legend-swatch {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: currentColor;
}

/* --------------------------------------------------------------------------
   §5B. Capability summary rows — summary first, context on demand.
   -------------------------------------------------------------------------- */
.cards {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.card { display: flex; flex-direction: column; gap: 8px; }
.card-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8px 16px;
}
.card-title { margin: 0; }
.card-summary .workload-icon { width: 18px; height: 18px; }
.card p { margin: 0; }
.card-provenance {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-block-start: 8px;
  border-block-start: 1px solid var(--border);
  font-size: 0.8125rem;
}

/* --------------------------------------------------------------------------
   §5C. Moves — a numbered sequence, first item visually dominant.
   -------------------------------------------------------------------------- */
.move-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.move-item {
  display: flex;
  gap: 16px;
  padding: 20px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 10px;
}
.move-item--lead {
  box-shadow: var(--shadow-1);
  background: var(--surface-3);
}
.move-item--lead .move-title { font-size: 1.25rem; }
.move-index { color: var(--accent); font-weight: 700; }
.move-body { display: flex; flex-direction: column; gap: 4px; }
.move-head { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.move-effort { color: var(--text-2); font-size: 0.8125rem; }
.move-why, .move-action, .move-ids, .move-link { margin: 0; }
.move-note { color: var(--text-3); font-size: 0.8125rem; }

/* --------------------------------------------------------------------------
   §5D. Findings — open typographic articles separated by rules; the
   selected finding becomes the one elevated surface.
   -------------------------------------------------------------------------- */
.finding {
  padding-block: 16px;
  border-block: 1px solid transparent;
}
.finding + .finding {
  border-block-start-color: var(--border);
  margin-block-start: 16px;
}
.finding.is-selected {
  background: var(--grad-raised);
  border-color: var(--border-strong);
  border-radius: 10px;
  box-shadow: var(--shadow-2);
  padding-inline: 20px;
  padding-block: 20px;
}
.finding.is-related { outline: 1px solid var(--accent); outline-offset: -1px; }
.card.is-related { outline: 1px solid var(--accent); outline-offset: -1px; }
.finding-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.finding-head h3 { margin: 0; }
.finding-meta { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-block: 8px 0; }
.meta-item { font-size: 0.8125rem; color: var(--text-2); }
.meta-key { color: var(--text-3); }
.meta-note { color: var(--text-3); font-style: italic; }
.finding-summary { margin-block: 8px 0; }
.belief-slot { margin-block: 12px 0; }
.belief-label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-2);
  margin-block-end: 4px;
}
.belief-slot p { margin: 0; }
.belief-meta { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-block: 8px 0; }
.evidence-keys { margin: 0; padding-inline-start: 1.2rem; }
.evidence-keys code { color: var(--text-1); }

/* --------------------------------------------------------------------------
   §5A / §9. Hero visualizations — radial realization gauge and the
   operational-distribution segmented bar.
   -------------------------------------------------------------------------- */
.posture {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 24px 32px;
  margin-block-start: 8px;
}

.posture-stat-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8px 16px;
  margin-block-start: 12px;
}
.stat-item { display: inline-flex; align-items: baseline; gap: 6px; }
.stat-item + .stat-item {
  border-inline-start: 1px solid var(--border);
  padding-inline-start: 16px;
}

/* Radial gauge: single proportion, drawn via stroke-dashoffset (§11). */
.radial-figure { margin: 0; text-align: center; }
.radial-svg { display: block; margin-inline: auto; }
.radial-track { stroke: var(--surface-4); }
.radial-arc {
  stroke: var(--accent);
  stroke-linecap: round;
  transform: rotate(-90deg);
  transform-origin: center;
}

/* Distribution: segments proportional to counts; pill caps authorized for
   proportion-based fills only (§4). Segments are buttons (§9). */
.dist-figure { margin-block: 24px 0; }
.dist-bar {
  display: flex;
  height: 12px;
  border-radius: 999px;
  overflow: hidden;
  background: var(--surface-4);
}
.dist-segment {
  border: none;
  border-radius: 999px;
  margin-inline-end: 2px;
  min-width: 0;
  min-height: 0;
  padding: 0;
  cursor: pointer;
  background: var(--state-neutral);
  transform-origin: left;
  transition: filter 150ms ease-out;
}
.dist-segment:last-child { margin-inline-end: 0; }
.dist-segment:hover { filter: brightness(1.2); }
.dist-segment.status-gap { background: var(--state-action); }
.dist-segment.status-partial { background: var(--state-incomplete); }
.dist-segment.status-ok { background: var(--state-ok); }
.dist-segment.status-not_licensed { background: var(--state-neutral); }

.dist-items {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 24px;
  list-style: none;
  margin-block: 12px 0;
  padding: 0;
}
.dist-item { display: inline-flex; align-items: center; gap: 6px; }

/* Implication + top actions close the opening sequence. */
.implication {
  margin-block: 20px 0;
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.6;
}
.posture-sentence { color: var(--text-2); margin-block: 8px 0; }

.top-actions {
  list-style: none;
  margin-block: 20px 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.top-action { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
.effort-label {
  display: inline-block;
  padding: 2px 8px;
  border: 1px solid var(--border-strong);
  border-radius: 6px;
  font-size: 0.75rem;
  color: var(--text-2);
}

/* Exposed rail: 3px action rail listing exposed / gap check titles. */
.exposed-rail {
  margin-block-start: 24px;
  padding-inline-start: 16px;
  border-inline-start: 3px solid var(--state-action);
}
.exposed-rail ul { margin: 4px 0 0; padding-inline-start: 1.2rem; }

/* --------------------------------------------------------------------------
   §5E. Exploration — charts, search, filter groups, sort, counts, list,
   pagination.
   -------------------------------------------------------------------------- */
.charts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  gap: 24px;
  margin-block: 8px 24px;
}
.chart {
  margin: 0;
  padding: 20px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 10px;
  min-width: 0;
}
.chart figcaption {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--text-2);
  margin-block-end: 12px;
}
.chart-body { display: flex; flex-direction: column; gap: 8px; }
.chart-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px 12px;
  align-items: center;
}
.chart-row__label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8125rem;
  color: var(--text-2);
  overflow-wrap: anywhere;
}
.chart-row__label .workload-icon { width: 16px; height: 16px; }
.chart-value {
  font-size: 0.8125rem;
  font-variant-numeric: tabular-nums;
  color: var(--text-1);
}
.chart-bar-track {
  grid-column: 1 / -1;
  height: 8px;
  background: var(--surface-4);
  border-radius: 999px;
  overflow: hidden;
}
.chart-bar {
  display: block;
  width: 100%;
  height: 100%;
  border: none;
  border-radius: 999px;
  padding: 0;
  min-width: 0;
  min-height: 0;
  cursor: pointer;
  background: var(--state-neutral);
  transform-origin: left;
  transition: filter 150ms ease-out;
}
.chart-bar:hover { filter: brightness(1.2); }
.chart-bar.active,
.dist-segment.active { filter: brightness(1.3); }
.chart-bar.status-gap { background: var(--state-action); }
.chart-bar.status-partial { background: var(--state-incomplete); }
.chart-bar.status-ok { background: var(--state-ok); }
.chart-bar.status-not_licensed, .chart-bar.status-skipped { background: var(--state-neutral); }
.chart-row.is-related .chart-bar-track { outline: 1px solid var(--accent); }

/* Chart equivalent data table: visually hidden on screen, styled print
   fallback (§9/§15). table-layout: fixed makes width:1px authoritative
   (tables otherwise grow to their min-content width and overflow). */
.chart-table {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
  table-layout: fixed;
}

/* The caption stays in the accessibility tree but is taken out of flow so
   its min-content width cannot floor the table's used width above 1px. */
.chart-table caption {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  white-space: nowrap;
}

/* Radial gauge accessible description: visually hidden on screen, visible
   in print as the gauge's textual replacement (§9/§15). */
.radial-print-line {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}

/* Generic visually-hidden utility (chart descriptions, auxiliary labels). */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}

/* Search, sort, filter controls. */
.search-box { margin-block-end: 16px; }
.search-box__label, .sort-box__label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-2);
  margin-block-end: 4px;
}
.search-box__input {
  width: 100%;
  max-width: 420px;
  padding: 8px 12px;
  background: var(--surface-2);
  border: 1px solid var(--border-strong);
  border-radius: 2px;
  color: var(--text-1);
  font-family: var(--font-sans);
  font-size: 1rem;
}

.sort-box { margin-block-end: 16px; }
.sort-box__select {
  padding: 8px 12px;
  background: var(--surface-2);
  border: 1px solid var(--border-strong);
  border-radius: 2px;
  color: var(--text-1);
  font-family: var(--font-sans);
  font-size: 1rem;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 16px;
  margin-block-end: 16px;
}
.filter-group { display: flex; flex-wrap: wrap; gap: 8px; }
.filter-button {
  padding: 4px 12px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text-2);
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  cursor: pointer;
}
.filter-button.active {
  background: var(--surface-3);
  border-color: var(--accent);
  color: var(--text-1);
}
.clear-filters {
  padding: 4px 12px;
  background: none;
  border: none;
  color: var(--accent);
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  text-decoration: underline;
  cursor: pointer;
}
.filter-count {
  color: var(--text-2);
  margin-inline-start: auto;
  font-variant-numeric: tabular-nums;
}

/* The findings list: one collapsed <details> row per finding, rendered in
   severity order (server-side; the JS re-sorts via data-engine-idx/rank).
   The closed summary carries the status marker, title, severity/workload
   meta, and a one-line signal; opening the row (details.tech disclosure
   pattern, §8) reveals the full belief block with the caret rotate +
   tech-body fade. */
.explore-list { display: flex; flex-direction: column; }
details.explore-row {
  padding: 12px 16px;
  border: 1px solid var(--border);
  border-inline-start-width: 3px;
  border-radius: 0;
}
details.explore-row + details.explore-row { border-block-start: 1px solid var(--border); }
/* Status rail on the collapsed row (the rail color is a secondary cue —
   the always-visible status-marker word carries status, never color-only). */
details.explore-row[data-status="gap"],
details.explore-row[data-status="error"] { border-inline-start-color: var(--state-action); }
details.explore-row[data-status="partial"] { border-inline-start-color: var(--state-incomplete); }
details.explore-row[data-status="ok"] { border-inline-start-color: var(--state-ok); }
details.explore-row[data-status="not_licensed"],
details.explore-row[data-status="skipped"] { border-inline-start-color: var(--state-neutral); }

details.explore-row summary {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4px 12px;
  cursor: pointer;
  color: var(--text-1);
  font-weight: 400;
  min-width: 0;
}
details.explore-row summary .caret { flex: none; color: var(--text-3); }
details.explore-row summary .status-marker { flex: none; }
.explore-row__title {
  display: inline;
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
  min-width: 0;
  overflow-wrap: anywhere;
}
.explore-row__title a { text-decoration: none; color: var(--text-1); }
.explore-row__title a:hover { text-decoration: underline; }
.explore-row__meta {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 4px 16px;
  margin-inline-start: auto;
  font-size: 0.8125rem;
  color: var(--text-2);
}
.explore-row__meta .meta-severity { font-weight: 600; color: var(--text-1); }
.explore-row__meta code { color: var(--text-1); }
.explore-row__signal {
  flex-basis: 100%;
  min-width: 0;
  margin: 0;
  color: var(--text-2);
  font-size: 0.8125rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* Expanded row: the tech disclosure's open pane; the inner belief card
   drops its own rail (the row already carries the status rail) and hugs
   the disclosure padding. */
details.explore-row[open] > .tech-body {
  margin-block-start: 12px;
  padding-block-start: 12px;
  border-block-start: 1px solid var(--border);
}
details.explore-row .finding {
  border-inline-start-width: 0;
  padding-inline: 0;
}
details.explore-row .finding-head h3 { font-size: 1.06rem; }

.empty-state { color: var(--text-2); }

.pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 16px;
  margin-block-start: 16px;
}
.pagination button {
  padding: 4px 12px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text-1);
  font-family: var(--font-sans);
  font-size: 0.8125rem;
  cursor: pointer;
}
.pagination button:disabled { color: var(--text-3); cursor: default; }
.pager-page {
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
.pager-size-select {
  margin-inline-start: auto;
  padding: 4px 8px;
  background: var(--surface-2);
  border: 1px solid var(--border-strong);
  border-radius: 2px;
  color: var(--text-1);
  font-family: var(--font-sans);
  font-size: 0.8125rem;
}

/* Table of contents (single-file §6): a prominent segmented control —
   the report's primary orientation affordance, not plain links. */
.toc {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding-block: 12px 16px;
  border-block-start: 1px solid var(--border);
}
.toc a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 8px 14px;
  border: 1px solid var(--border-strong);
  border-radius: 999px;
  background: var(--surface-2);
  color: var(--text-2);
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.2;
  text-decoration: none;
}
.toc a:hover {
  color: var(--accent-hover);
  border-color: var(--accent);
}
.toc a:first-child {
  color: var(--text-1);
  background: var(--surface-3);
  border-color: var(--accent);
  box-shadow: inset 0 0 0 1px var(--accent);
}

/* --------------------------------------------------------------------------
   Technical tables — radius 0, mono cells, scrollable at 640px.
   -------------------------------------------------------------------------- */
.table-scroll {
  overflow-x: auto;
  /* §4 visible scroll affordance — same language as the constellation. */
  scrollbar-color: var(--surface-4) transparent;
}
table { border-collapse: collapse; width: 100%; }
th, td {
  text-align: start;
  padding: 8px;
  border: 1px solid var(--border);
  vertical-align: top;
}
th { color: var(--text-2); font-weight: 600; }
td code { color: var(--text-1); }

/* --------------------------------------------------------------------------
   §11. Motion contract — information arriving, once, gated behind
   body.revealed (JS opt-in). Without JS the page is fully visible and
   static. Only transform / opacity / stroke-dashoffset / color-resolve
   animate; nothing loops; nothing animates on scroll or input.
   -------------------------------------------------------------------------- */
@keyframes rise {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes gauge-draw {
  from { stroke-dashoffset: var(--gauge-circumference, 0); }
}

@keyframes bar-fill {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

@keyframes constellation-resolve {
  from { color: var(--state-neutral); }
  to { color: var(--resolve-to, var(--state-neutral)); }
}

/* Opening sequence (§11): stages 1, 2, 5, 6, 7 — fade + 6px rise. */
body.revealed .opening-stage {
  opacity: 0;
  animation: rise 200ms ease-out both;
}
body.revealed .opening-identity { animation-delay: 0ms; }
body.revealed .opening-meta { animation-delay: 60ms; }
body.revealed .dist-item { animation-duration: 250ms; }
body.revealed .dist-item:nth-child(1) { animation-delay: 260ms; }
body.revealed .dist-item:nth-child(2) { animation-delay: 320ms; }
body.revealed .dist-item:nth-child(3) { animation-delay: 380ms; }
body.revealed .dist-item:nth-child(4) { animation-delay: 440ms; }
body.revealed .implication { animation-duration: 300ms; animation-delay: 380ms; }
body.revealed .top-action { animation-duration: 300ms; }
body.revealed .top-action:nth-child(1) { animation-delay: 540ms; }
body.revealed .top-action:nth-child(2) { animation-delay: 620ms; }
body.revealed .top-action:nth-child(3) { animation-delay: 700ms; }

/* Stage 4a: radial gauge draw (700ms, delay 160ms). */
body.revealed .radial-arc {
  animation: gauge-draw 700ms ease-out 160ms both;
}

/* Stage 4b: distribution segments scaleX left-to-right (600ms, 200ms). */
body.revealed .dist-segment {
  animation: bar-fill 600ms ease-out 200ms both;
}
body.revealed .dist-segment:nth-child(2) { animation-delay: 240ms; }
body.revealed .dist-segment:nth-child(3) { animation-delay: 280ms; }
body.revealed .dist-segment:nth-child(4) { animation-delay: 320ms; }

/* §9: chart bars construct on first reveal (500ms, 40ms per row). */
body.revealed .chart-bar {
  animation: bar-fill 500ms cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
}

/* §7: constellation resolve, neutral -> status color, column by column
   (450ms ease-out, 50ms per column via inline animation-delay). */
body.revealed .constellation-point {
  animation: constellation-resolve 450ms ease-out both;
}

/* Interactive states: color, border, background only, <=150ms. */
button,
a,
input,
select,
summary {
  transition-property: color, background-color, border-color, filter;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

button,
select,
summary { cursor: pointer; }

/* §4. Target sizes: coarse pointer 44x44 minimum, fine pointer 24x24. */
button,
input,
select,
summary {
  min-width: 44px;
  min-height: 44px;
}

@media (pointer: fine) {
  button,
  input,
  select,
  summary {
    min-width: 24px;
    min-height: 24px;
  }
}

/* --------------------------------------------------------------------------
   §11. Reduced motion — the instant final state: duration 0, single
   iteration, no transform offset ever applied. Posture digits, gauges,
   bars, nodes, and section reveals appear fully resolved immediately.
   -------------------------------------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition-duration: 0s !important;
    transition-delay: 0s !important;
    animation-duration: 0s !important;
    animation-delay: 0s !important;
    animation-iteration-count: 1 !important;
  }

  body.revealed .opening-stage,
  body.revealed .reveal-target,
  body.revealed .dist-segment,
  body.revealed .chart-bar,
  body.revealed .constellation-point {
    opacity: 1 !important;
    transform: none !important;
  }

  body.revealed .radial-arc { animation: none !important; }
  details.tech summary .caret { transform: none !important; }
}

/* Reduced motion + JS: the shared foundation keeps the node color coming
   from the static `.status-*` class (no animation required for correctness);
   under reduced motion the bundle app.js adds `body.instant` instead of
   `body.revealed`, so the instant final state restores the status color
   directly (zero information loss, DESIGN_V2 §11). */
body.instant .constellation-point { color: var(--resolve-to, var(--state-neutral)); }

/* --------------------------------------------------------------------------
   §14. Forced colors — glyphs, node rings, and bars fall back to system
   colors; backgrounds collapse to Canvas/CanvasText; brand icons keep
   their shapes via forced-color-adjust: auto.
   -------------------------------------------------------------------------- */
@media (forced-colors: active) {
  body,
  header,
  main,
  section,
  article,
  .hero,
  .card,
  .finding,
  details.tech,
  .chart {
    background: Canvas;
    color: CanvasText;
    border-color: CanvasText;
    box-shadow: none;
  }

  a,
  .posture-figure,
  .constellation-caption { color: LinkText; }

  .status-gap,
  .status-error,
  .status-partial,
  .status-ok,
  .status-not_licensed,
  .status-skipped { color: CanvasText; }

  /* Two-class selectors so the system ink beats the screen `.status-marker.gap`
     rules (same specificity, later source). Chromium's forced-colors palette
     adjustment remaps the author state colors differently per parent (the
     disclosure summary maps to a link-ish palette entry), so the marker must
     resolve to the system color directly — never through an author color. */
  .status-marker.gap,
  .status-marker.error,
  .status-marker.partial,
  .status-marker.ok,
  .status-marker.not_licensed,
  .status-marker.skipped,
  .status-marker svg {
    color: CanvasText;
    background: transparent;
    fill: none;
    stroke: CanvasText;
  }

  .finding.gap,
  .finding.error,
  .finding.partial,
  .finding.ok,
  .finding.not_licensed,
  .finding.skipped { border-inline-start-color: CanvasText; }

  /* The collapsed finding-row rail collapses to system ink too. */
  details.explore-row[data-status] { border-inline-start-color: CanvasText; }

  .constellation-core { border-color: CanvasText; }
  .constellation-core::before { background: CanvasText; }
  .dist-segment,
  .chart-bar { background: CanvasText; }
  .dist-segment.status-gap,
  .dist-segment.status-partial,
  .dist-segment.status-ok,
  .chart-bar.status-gap,
  .chart-bar.status-partial,
  .chart-bar.status-ok { background: CanvasText; }
  .radial-arc { stroke: CanvasText; }
  .workload-icon { forced-color-adjust: auto; }

  :focus-visible {
    outline: 2px solid Highlight;
    outline-offset: 2px;
  }
}

/* --------------------------------------------------------------------------
   §15. Print — light inversion: paper, print ink, print borders, print
   status colors; shadows suppressed; gradients flattened; disclosures
   expanded; chart tables become visible textual fallbacks.
   -------------------------------------------------------------------------- */
@media print {
  html,
  body {
    background: var(--print-paper) !important;
    color: var(--print-ink) !important;
  }

  body {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* Suppress all shadows; the two gradients flatten. */
  *,
  *::before,
  *::after { box-shadow: none !important; }

  /* Every dark surface becomes paper; rules become print rules. */
  header,
  main,
  section,
  article,
  footer,
  .card,
  .finding,
  details.tech,
  .chart,
  .move-item {
    background: var(--print-paper) !important;
    border-color: var(--print-border) !important;
  }

  .hero {
    background: var(--print-hero) !important;
    border: 2px solid var(--print-border-strong) !important;
  }

  /* All ink becomes print ink; accent becomes print accent. */
  h1,
  h2,
  h3,
  p,
  li,
  td,
  th,
  .display-line,
  .label,
  .micro-label,
  .caption,
  .constellation-label { color: var(--print-ink) !important; }

  a,
  .posture-figure,
  .posture-digits { color: var(--accent-print) !important; }

  /* Status labels: transparent backgrounds, contrast-safe print colors. */
  .status-marker,
  .status-label,
  .badge { background: transparent !important; }

  .status-gap,
  .status-error { color: var(--print-action) !important; }
  .status-partial { color: var(--print-incomplete) !important; }
  .status-ok { color: var(--print-ok) !important; }
  .status-not_licensed,
  .status-skipped { color: var(--print-neutral) !important; }

  .status-marker.gap,
  .status-marker.error { color: var(--print-action) !important; }
  .status-marker.partial { color: var(--print-incomplete) !important; }
  .status-marker.ok { color: var(--print-ok) !important; }
  .status-marker.not_licensed,
  .status-marker.skipped { color: var(--print-neutral) !important; }

  .finding.gap,
  .finding.error { border-inline-start-color: var(--print-action) !important; }
  .finding.partial { border-inline-start-color: var(--print-incomplete) !important; }
  .finding.ok { border-inline-start-color: var(--print-ok) !important; }
  .finding.not_licensed,
  .finding.skipped { border-inline-start-color: var(--print-neutral) !important; }

  .dist-segment,
  .chart-bar { background: var(--print-neutral) !important; }
  .dist-segment.status-gap { background: var(--print-action) !important; }
  .dist-segment.status-partial { background: var(--print-incomplete) !important; }
  .dist-segment.status-ok { background: var(--print-ok) !important; }
  .chart-bar.status-gap { background: var(--print-action) !important; }
  .chart-bar.status-partial { background: var(--print-incomplete) !important; }
  .chart-bar.status-ok { background: var(--print-ok) !important; }
  .radial-arc { stroke: var(--accent-print) !important; }
  .radial-track { stroke: var(--print-border) !important; }

  /* Expanded content predictable: every disclosure renders expanded, and
     every finding the filter may have hidden stays in the artifact. */
  details.tech:not([open]) > :not(summary) { display: block; }
  .finding[hidden],
  .explore-row[hidden] { display: block !important; }

  /* Visualizations get textual fallbacks: the sr-only data tables become
     visible styled print tables; the radial gauge is replaced by its
     description line. */
  .chart-table {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    clip-path: none;
    white-space: normal;
    border: 1px solid var(--print-border);
    margin-block-start: 8px;
    table-layout: auto;
  }
  .chart-table caption {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    white-space: normal;
  }
  .radial-svg { display: none !important; }
  .radial-print-line {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    clip-path: none;
    white-space: normal;
    border: 0;
  }

  /* Hide technical chrome (nav, filters, pager). The provenance footer
     stays: it is part of the printed provenance record. */
  .toc,
  .search-box,
  .sort-box,
  .filter-bar,
  .pagination { display: none !important; }

  /* Hero, move items, capability rows, findings, the constellation, and its
     legend stay whole across pages. */
  .hero,
  .card,
  .finding,
  .constellation,
  .constellation-legend,
  .chart {
    break-inside: avoid;
    page-break-inside: avoid;
  }
}

/* --------------------------------------------------------------------------
   §4. Responsive — 900px: two-column hero collapses, nav wraps.
   640px: gutters halve, hero figure scales down, constellation scrolls
   horizontally, tables scroll.
   -------------------------------------------------------------------------- */
@media (max-width: 900px) {
  .posture {
    grid-template-columns: minmax(0, 1fr);
  }
  .radial-figure { text-align: start; }
  .radial-svg { margin-inline: 0; }
}

@media (max-width: 640px) {
  header,
  main {
    padding-inline: 16px;
  }
  section {
    padding-block: 16px;
    padding-inline: 16px;
  }
  .hero {
    padding-block: 24px;
    padding-inline: 16px;
  }
  .posture-figure { font-size: 2.5rem; }
  .display-line { font-size: 1.5rem; }
  .constellation {
    /* The field returns to a single-row column flow that scrolls inside
       itself (the §4 affordance language); the legend stays a wrapping
       sibling row below it and never scrolls with the field. */
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(180px, 72vw);
    scrollbar-width: thin;
  }
  .explore-row__meta { margin-inline-start: 0; flex-basis: 100%; }

  /* Tables grow to their content width and scroll inside the wrapper
     instead of squeezing (§4); mono tokens (part numbers, check IDs)
     never break mid-token — the wrapper is the overflow container. */
  .table-scroll { scrollbar-width: thin; }
  .table-scroll table { min-width: max-content; }
  .table-scroll td code {
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
  }
}

/* --------------------------------------------------------------------------
   Footer.
   -------------------------------------------------------------------------- */
footer {
  max-width: 1160px;
  margin-block: 16px;
  margin-inline: auto;
  padding-inline: 32px;
  color: var(--text-3);
  font-size: 0.8125rem;
}

/* Provenance footer: evidence-mode legend, methodology note, sampled-vs-
   enumerated disclosure, and the assessment identity + generated timestamp.
   Deliberately quiet — one hairline above, muted ink, small caps headings. */
.report-footer { border-block-start: 1px solid var(--border); padding-block-start: 12px; }
.report-footer__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 8px 32px;
  margin-block-end: 12px;
}
.report-footer__heading {
  margin-block: 0 6px;
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-3);
}
.report-footer__legend {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 20px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.report-footer__method { margin-block: 8px 0; }
.report-footer__coverage { margin-block: 0; }
.report-footer__identity { margin-block: 8px 0; }
.report-footer__tagline { margin-block: 4px 0; }

@media (max-width: 640px) {
  .report-footer { padding-inline: 16px; }
}
