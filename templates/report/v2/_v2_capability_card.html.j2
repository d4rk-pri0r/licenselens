{#
  v2 B-section partial: capability summary rows + the capability constellation.

  Consumed by BOTH v2 renderers via `{% from "report/v2/_v2_capability_card.html.j2"
  import capability_constellation, capability_cards %}`. It binds the plain-data
  view-model payload from `licenselens.report.viewmodel`:

    capability_constellation(constellation, workload_svg_map=none, workload_icon_urls=none)
      constellation := viewmodel.build_constellation(result)
      One entry per capability outcome with exactly these keys: `id`, `name`,
      `plain_name`, `status`, `status_label`, `workload` (str | None),
      `related_check_ids` (int). The list arrives pre-ordered by workload
      priority then `plain_name` byte sort — this template NEVER re-sorts.
      The single-file renderer MAY extend each entry with a decorative
      `svg` key (inline workload mark) before calling — see capability_cards.

      The two icon kwargs are explicit because `{% from %}`-imported macros do
      not see the calling template's context (Jinja import semantics; v1 used
      `{% include %}` instead). The single-file renderer passes
      `workload_svg_map` (decorative inline SVG markup); the bundle renderer
      passes `workload_icon_urls` (hashed offline asset paths).

    capability_cards(capabilities, constellation)
      capabilities := viewmodel.build_sections(result)["B"]
      One entry per capability summary with keys: `id`, `name`, `plain_name`,
      `matched_skus`, `matched_service_plans`, `friendly_skus`,
      `friendly_plans`, `outcome`, `why_it_matters`, `if_unused`, `docs_url`,
      `status` (str | None), `status_label`. The raw `matched_*` lists stay
      available for tooltips/technical areas; the friendly lists are the
      primary rendered text.

  DESIGN_V2.md section 7 binding behavior:
    - Group captions are BUTTONS (brand icon + visible text label): activating
      one toggles the workload facet filter across the page (cross-filtering).
    - Nodes are BUTTONS (16x16px circle + always-visible label): activating a
      node selects the capability (filters section D to its related checks).
    - Workload selection reconfigures the field: the selected workload's group
      becomes the first column (FLIP-animated by the renderer JS), the group
      gains `is-selected`; "All" restores the default enum order.
    - Nodes resolve from neutral to their status color column by column
      (450ms ease-out, 50ms per column via inline animation-delay).
    - The status legend renders as a SIBLING BLOCK BELOW the field (a wrapping
      row at every width), never as a grid column: `.constellation` contains
      ONLY the `.constellation-group` columns, because the renderers' JS
      reorders those children in place and the bundle's app.css owns the
      `.constellation` grid/scroll/print rules.

  Determinism contract (DESIGN_V2.md section 7): server-rendered static
  markup. No randomness, no node-link topology, no canvas. Workload groups
  render as columns in the exact view-model order; nodes stack top-to-bottom
  within a column in the view-model order. Identical input yields identical
  pixels.

  Workload-mark contract (branded-icon allowlist restored, section 12): each
  group caption shows the pinned Microsoft product mark next to its visible
  text label. Marks are decorative (`aria-hidden` / `focusable="false"`) and
  never replace or hide the text label; status is never conveyed by them.

  Variant-signal contract (v1 parity): every card and every constellation
  node exposes `data-status` and `data-workload`; cards additionally keep the
  v1 `data-variant` attribute. Fallbacks: status `not_licensed`, workload
  `general` — the attributes are therefore always present.
#}
{%- import "report/v2/_v2_primitives.html.j2" as prim -%}

{%- set WORKLOAD_LABELS = {
    'identity': 'Identity',
    'endpoint': 'Endpoint',
    'defender': 'Defender',
    'sentinel': 'Sentinel',
    'purview': 'Purview',
    'exchange': 'Exchange',
    'collaboration': 'Collaboration',
    'teams': 'Teams',
    'power_platform': 'Power Platform',
    'power_bi': 'Power BI',
    'intune': 'Intune',
    'azure': 'Azure',
    'general': 'General',
} -%}

{#- Tiny legend: the six status words (v1 PRESENTATION vocabulary), color via
    the shared `.status-*` classes. #}
{%- set STATUS_LEGEND = [
    ('gap', 'Action required'),
    ('partial', 'Incomplete'),
    ('ok', 'Operational'),
    ('not_licensed', 'Not licensed'),
    ('skipped', 'Not assessed'),
    ('error', 'Verification failed'),
] -%}


{#- §7 field: `.constellation` is the grid of group columns ONLY (the renderers'
    JS reorder its `.constellation-group` children in place, and the bundle's
    app.css still owns the `.constellation` grid/scroll/print rules, so the grid
    element must keep this class). The status legend is a SIBLING BLOCK BELOW the
    field, never a grid column — a wrapping row at every width. #}
{%- macro capability_constellation(constellation, workload_svg_map=none, workload_icon_urls=none) -%}
{%- if constellation -%}
<div class="constellation" data-constellation role="group" aria-label="Capability constellation">
  {%- set ns = namespace(group_open=false, current=none, col_index=0, col_delay=0) -%}
  {%- for entry in constellation -%}
    {%- set wl = entry.workload or 'general' -%}
    {%- set variant = prim.CAPABILITY_VARIANT.get(entry.status, entry.status) -%}
    {%- if not ns.group_open or wl != ns.current -%}
      {%- if ns.group_open %}</div>{% endif -%}
      {%- set ns.current = wl -%}
      {%- set ns.group_open = true -%}
      {%- set ns.col_delay = ns.col_index * 50 -%}
      {%- set ns.col_index = ns.col_index + 1 -%}
  <div class="constellation-group" data-workload="{{ wl }}">
    <button type="button" class="constellation-caption" data-workload="{{ wl }}" aria-pressed="false">
      {%- if workload_svg_map and workload_svg_map.get(wl) -%}
      {{ workload_svg_map[wl] }}
      {%- elif workload_icon_urls and workload_icon_urls.get(wl) -%}
      <img class="workload-icon" src="{{ workload_icon_urls[wl] }}" width="16" height="16" alt="" decoding="async" aria-hidden="true" />
      {%- endif -%}
      <span class="constellation-caption-label">{{ WORKLOAD_LABELS.get(wl, wl | replace('_', ' ') | title) }}</span>
    </button>
    {%- endif -%}
    <button type="button" class="constellation-point status-{{ variant }}" data-capability-id="{{ entry.id }}" data-status="{{ entry.status }}" data-workload="{{ wl }}" aria-pressed="false" aria-label="{{ entry.plain_name }}: {{ entry.status_label or entry.status }}" style="animation-delay: {{ ns.col_delay }}ms">
      <span class="constellation-core" aria-hidden="true"></span>
      <span class="constellation-label">{{ entry.plain_name }}</span>
    </button>  {%- endfor -%}
  {%- if ns.group_open %}</div>{% endif -%}
</div>
{#- Legend: sibling block BELOW the field (todo 5 — was a grid column because
    `grid-column: 1 / -1` is meaningless in an implicit-column grid). #}
<div class="constellation-legend" aria-label="Capability status legend">
  {%- for variant, word in STATUS_LEGEND -%}
  <span class="constellation-legend-chip status-{{ variant }}"><span class="constellation-legend-swatch" aria-hidden="true"></span>{{ word }}</span>
  {%- endfor -%}
</div>
{%- else -%}
<p class="caption">No capability outcomes were resolved from entitlements.</p>
{%- endif -%}
{%- endmacro -%}


{%- macro capability_cards(capabilities, constellation) -%}
{%- if capabilities -%}
{%- set workload_by_id = {} -%}
{%- set svg_by_workload = {} -%}
{%- for entry in constellation -%}
  {%- set _ = workload_by_id.update({entry.id: entry.workload or 'general'}) -%}
  {%- if entry.svg is defined and entry.svg -%}
  {%- set _ = svg_by_workload.update({entry.workload or 'general': entry.svg}) -%}
  {%- endif -%}
{%- endfor -%}
<div class="cards">
  {%- for card in capabilities -%}
  {%- set status = card.status or 'not_licensed' -%}
  {%- set wl = workload_by_id.get(card.id, 'general') -%}
  <article class="card" data-variant="{{ status }}" data-status="{{ status }}" data-workload="{{ wl }}" data-capability-id="{{ card.id }}">
    <div class="card-summary">
      {%- if svg_by_workload.get(wl) -%}{{ svg_by_workload[wl] }}{%- endif -%}
      {{ prim.status_marker(status) }}
      <h3 class="card-title">{{ card.plain_name }}</h3>
    </div>
    {%- if card.outcome -%}
    <p><span class="label">What it does</span> {{ card.outcome }}</p>
    {%- endif -%}
    <details class="tech card-details">
      <summary><span class="caret" aria-hidden="true">▸</span> Why it matters and what's covered</summary>
      <div class="tech-body">
        {%- if card.why_it_matters -%}
        <p><span class="label">Why it matters</span> {{ card.why_it_matters }}</p>
        {%- endif -%}
        {%- if card.if_unused -%}
        <p><span class="label">If left off</span> {{ card.if_unused }}</p>
        {%- endif -%}
        <div class="card-provenance">
          <div><span class="label">Microsoft control</span> <span class="mono">{{ card.name }}</span></div>
          <div><span class="label">License</span> <span title="{{ card.matched_skus | join(', ') }}">{{ card.friendly_skus | join(', ') or 'Not reported' }}</span></div>
          <div><span class="label">Service plan</span> <span title="{{ card.matched_service_plans | join(', ') }}">{{ card.friendly_plans | join(', ') or 'No matching service plan reported' }}</span></div>
        </div>
      </div>
    </details>
  </article>
  {%- endfor -%}
</div>
{%- else -%}
<p class="caption">No licensed capabilities were resolved from entitlements.</p>
{%- endif -%}
{%- endmacro -%}
