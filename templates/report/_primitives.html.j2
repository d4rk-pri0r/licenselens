{%- set PRESENTATION = {
    'gap': 'Action required',
    'partial': 'Incomplete',
    'ok': 'Operational',
    'not_licensed': 'Not licensed',
    'skipped': 'Not assessed',
    'error': 'Verification failed',
} -%}

{%- set CAPABILITY_PRESENTATION = {
    'needs_attention': 'Action required',
    'partly_set_up': 'Incomplete',
    'fully_working': 'Operational',
    'not_licensed': 'Not licensed',
} -%}

{%- set CAPABILITY_VARIANT = {
    'needs_attention': 'gap',
    'partly_set_up': 'partial',
    'fully_working': 'ok',
    'not_licensed': 'not_licensed',
} -%}

{%- macro status_glyph(variant) -%}
{%- if variant == 'gap' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4 4h7v3H7v10h4v3H4V4zm9 0 7 8-7 8v-5h-4v-6h4V4z"/></svg>
{%- elif variant == 'partial' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4 4h16v16H4V4zm3 3v10h5V7H7z"/><path fill="none" stroke="currentColor" stroke-width="2" d="M4 4h16v16H4z"/></svg>
{%- elif variant == 'ok' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M7.5 12.5 10.5 15.5 16.5 9"/></svg>
{%- elif variant == 'not_licensed' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M8 8l8 8"/></svg>
{%- elif variant == 'skipped' -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M6 12h12"/></svg>
{%- else -%}
<svg class="status-glyph" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 3 22 20H2L12 3zm0 5.5c-.7 0-1.2.6-1.1 1.3l.5 5.2h1.2l.5-5.2c.1-.7-.4-1.3-1.1-1.3zM12 18.2a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2z"/></svg>
{%- endif -%}
{%- endmacro -%}

{%- macro status_marker(status) -%}
  {%- if status in PRESENTATION -%}
    {%- set variant = status -%}
    {%- set word = PRESENTATION[status] -%}
  {%- else -%}
    {%- set variant = CAPABILITY_VARIANT.get(status, status) -%}
    {%- set word = CAPABILITY_PRESENTATION.get(status, status) -%}
  {%- endif -%}
<span class="status-marker {{ variant }}">{{ status_glyph(variant) }}{{ word }}</span>
{%- endmacro -%}

{%- macro status_badge(status_value, label) -%}
  {%- set word = PRESENTATION.get(status_value, label) -%}
<span class="badge {{ status_value }}">{{ word }}</span>
{%- endmacro -%}

{%- macro meta_row(label, value) -%}
<div>{{ label }} <code>{{ value }}</code></div>
{%- endmacro -%}
