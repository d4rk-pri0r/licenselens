    {% if result.moves %}
    <section>
      <h2>Priority actions</h2>
      <p class="section-help">
        Ranked by security impact, evidence confidence, and estimated effort.
      </p>
      <ol class="steps">
        {% for move in result.moves %}
        <li class="step">
          <span class="step-index">{{ '%02d' | format(loop.index) }}</span>
          <div class="step-body">
            <div class="step-head">
              <strong class="step-title">{{ move.title }}</strong>
              {% if move.effort_label %}<span class="step-effort">{{ move.effort_label | lower }}</span>{% endif %}
            </div>
            {% if move.why %}<p class="step-why">{{ move.why }}</p>{% endif %}
            {% if move.customer_next_step %}<p class="step-action"><strong>Action:</strong> {{ move.customer_next_step }}</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
      <p style="color: var(--text-2); font-size: 0.85rem; margin: 0.75rem 0 0;">
        Effort is a rough guide, not a quote.
      </p>
    </section>
    {% endif %}

    <section>
      <h2>Assessment findings</h2>
      <p class="section-help">
        Evidence, scope, and remediation for each assessed control.
      </p>
      <div class="filter-bar">
        <div class="filter-group" role="group" aria-label="Filter by status">
          {% for s in ["all", "gap", "partial", "ok", "not_licensed", "skipped", "error"] %}
          <button data-filter="{{ s }}" aria-pressed="{{ 'true' if s == 'all' else 'false' }}"{% if s == 'all' %} class="active"{% endif %}>{{ 'All' if s == 'all' else prim.PRESENTATION.get(s, s) }}</button>
          {% endfor %}
        </div>
        <div class="filter-group" role="group" aria-label="Filter by workload">
          {% for w in ["all", "identity", "endpoint", "defender", "sentinel", "purview"] %}
          <button data-workload="{{ w }}" aria-pressed="{{ 'true' if w == 'all' else 'false' }}"{% if w == 'all' %} class="active"{% endif %}>{{ 'All' if w == 'all' else w | capitalize }}</button>
          {% endfor %}
        </div>
        <span class="filter-count" role="status" aria-live="polite" aria-atomic="true">Showing <strong data-visible-count>{{ findings|length }}</strong> of <strong data-total-count>{{ findings|length }}</strong></span>
      </div>
      {% for f in findings %}
      <article class="finding {{ f.status.value }}" data-status="{{ f.status.value }}" data-workload="{{ f.workload.value }}">
        <div class="finding-head">
          {{ prim.status_marker(f.status.value) }}
          <h3>{{ f.display_customer_title }}</h3>
        </div>
        <div class="finding-meta">
          {% if f.severity %}<span class="meta-item"><span class="meta-key">Severity:</span> {{ f.severity.value | capitalize }}</span>{% endif %}
          {% if f.effort_label %}<span class="meta-item"><span class="meta-key">Effort:</span> {{ f.effort_label }}</span>{% endif %}
          {% if f.blast_radius %}<span class="meta-item"><span class="meta-key">Scope:</span> {{ f.blast_radius.value | replace('_', ' ') }}</span>{% endif %}
          {% if f.workload %}<span class="meta-item"><span class="meta-key">Workload:</span> {{ f.workload.value | capitalize }}</span>{% endif %}
        </div>
        {% if f.customer_summary %}<p>{{ f.customer_summary }}</p>{% endif %}
        {% if f.customer_next_step %}<p><strong>Action:</strong> {{ f.customer_next_step }}</p>{% endif %}
        <details class="tech">
          <summary>Evidence and Microsoft admin page</summary>
          <p><strong>Confidence:</strong> {{ f.confidence_label or f.confidence.value }}</p>
          <p><strong>Data sources:</strong> {{ f.data_sources | join(', ') or 'Not reported' }}</p>
          <p><strong>Limitations:</strong> {% if f.limitations %}{% for limit in f.limitations %}{{ limit.rstrip('.') }}{% if not loop.last %}; {% endif %}{% endfor %}{% else %}None reported{% endif %}</p>
          {% if f.deep_link %}<p><a href="{{ f.deep_link }}">Open Microsoft admin page</a></p>{% endif %}
          <p><strong>Technical ID:</strong> <code>{{ f.check_id }}</code></p>
        </details>
      </article>
      {% else %}
      <p style="color: var(--text-2); margin: 0;">No findings.</p>
      {% endfor %}
    </section>
