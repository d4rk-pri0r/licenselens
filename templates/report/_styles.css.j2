    :root {
      --bg: #0b1220;
      --panel: #121a2b;
      --text: #e8eefc;
      --muted: #9aa8c7;
      --accent: #5b9dff;
      --gap: #f07178;
      --partial: #ffcc66;
      --ok: #7fd99a;
      --notlic: #7a8499;
      --skipped: #8b95a8;
      --border: #243049;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      background: radial-gradient(1200px 600px at 10% -10%, #1a2744 0%, var(--bg) 55%);
      color: var(--text);
      line-height: 1.55;
    }
    header, main { max-width: 1100px; margin: 0 auto; padding: 1.5rem; }
    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
    }
    .logo-mark {
      position: relative;
      width: 38px; height: 38px;
      border-radius: 50%;
      background: radial-gradient(circle at 50% 50%, transparent 38%, var(--accent) 39%, var(--accent) 52%, transparent 53%);
      flex-shrink: 0;
    }
    .logo-mark::before {
      content: "";
      position: absolute;
      inset: 4px;
      border-radius: 50%;
      border: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
    }
    .logo-mark::after {
      content: "";
      position: absolute;
      inset: 10px;
      border-radius: 50%;
      background: radial-gradient(circle at 50% 50%, transparent 55%, color-mix(in srgb, var(--accent) 30%, transparent) 56%);
    }
    header h1 { margin: 0 0 0.25rem; font-size: 1.75rem; }
    header .tagline { margin: 0; color: var(--muted); font-size: 1.05rem; }
    .meta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; color: var(--muted); font-size: 0.95rem; }
    .intro {
      background: color-mix(in srgb, var(--accent) 12%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
      border-radius: 12px;
      padding: 1rem 1.25rem;
      margin: 1.25rem 0 0.5rem;
      color: var(--text);
    }
    .intro strong { color: #fff; }
    .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin: 1.25rem 0; }
    .tile {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
    }
    .tile .n { font-size: 1.6rem; font-weight: 700; }
    .tile .l { color: var(--muted); font-size: 0.85rem; margin-top: 0.15rem; }
    .tile .l small { display: block; opacity: 0.7; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.2rem; }
    section {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      margin-bottom: 1rem;
    }
    h2 { margin: 0 0 0.35rem; font-size: 1.15rem; }
    .section-help { margin: 0 0 1rem; color: var(--muted); font-size: 0.95rem; }
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      align-items: center;
      margin-bottom: 0.75rem;
    }
    .filter-bar button {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 999px;
      color: var(--muted);
      padding: 0.3rem 0.75rem;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .filter-bar button:hover { border-color: var(--accent); color: var(--text); }
    .filter-bar button.active {
      background: color-mix(in srgb, var(--accent) 20%, var(--panel));
      border-color: var(--accent);
      color: var(--accent);
    }
    .filter-count {
      margin-left: auto;
      color: var(--muted);
      font-size: 0.82rem;
    }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.85rem; }
    .card {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      background: color-mix(in srgb, var(--bg) 45%, var(--panel));
    }
    .card h3 { margin: 0 0 0.35rem; font-size: 1.02rem; }
    .card .msft { color: var(--muted); font-size: 0.85rem; margin-bottom: 0.65rem; }
    .card p { margin: 0.4rem 0; font-size: 0.92rem; }
    .card p span { color: var(--muted); font-weight: 600; }
    .cap-status {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.78rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }
    .cap-status::before {
      content: "";
      width: 8px; height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .cap-status.needs_attention { color: var(--gap); }
    .cap-status.needs_attention::before { background: var(--gap); }
    .cap-status.partly_set_up { color: var(--partial); }
    .cap-status.partly_set_up::before { background: var(--partial); }
    .cap-status.fully_working { color: var(--ok); }
    .cap-status.fully_working::before { background: var(--ok); }
    .finding {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      margin-bottom: 0.75rem;
      background: color-mix(in srgb, var(--bg) 40%, var(--panel));
    }
    .finding:last-child { margin-bottom: 0; }
    .finding.gap { border-left: 3px solid var(--gap); }
    .finding.partial { border-left: 3px solid var(--partial); }
    .finding.ok { border-left: 3px solid var(--ok); }
    .finding.not_licensed { border-left: 3px solid var(--notlic); }
    .finding.skipped, .finding.error { border-left: 3px solid var(--skipped); }
    .finding-head { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: center; margin-bottom: 0.5rem; }
    .finding-head h3 { margin: 0; font-size: 1.02rem; flex: 1 1 220px; }
    .finding-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.75rem;
      margin-bottom: 0.5rem;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .finding-meta .meta-item {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }
    .steps { margin: 0; padding-left: 1.2rem; }
    .steps li { margin: 0.45rem 0; }
    table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    th, td { text-align: left; padding: 0.55rem 0.4rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    th { color: var(--muted); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .badge {
      display: inline-block;
      padding: 0.18rem 0.55rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .badge.gap { background: color-mix(in srgb, var(--gap) 25%, transparent); color: var(--gap); }
    .badge.partial { background: color-mix(in srgb, var(--partial) 25%, transparent); color: var(--partial); }
    .badge.ok { background: color-mix(in srgb, var(--ok) 25%, transparent); color: var(--ok); }
    .badge.not_licensed { background: color-mix(in srgb, var(--notlic) 25%, transparent); color: var(--notlic); }
    .badge.skipped, .badge.error { background: color-mix(in srgb, var(--skipped) 25%, transparent); color: var(--skipped); }
    .badge.effort {
      background: color-mix(in srgb, var(--muted) 18%, transparent);
      color: var(--muted);
    }
    details.tech {
      margin-top: 0.25rem;
      border: 1px dashed var(--border);
      border-radius: 12px;
      padding: 0.75rem 1rem;
      background: var(--panel);
    }
    details.tech > summary {
      cursor: pointer;
      color: var(--muted);
      font-weight: 600;
      list-style: none;
    }
    details.tech > summary::before {
      content: "▸ ";
      display: inline-block;
      margin-right: 0.25rem;
      transition: transform 0.15s ease;
    }
    details.tech[open] > summary::before {
      content: "▾ ";
    }
    details.tech > summary::-webkit-details-marker { display: none; }
    details.tech[open] > summary { margin-bottom: 0.75rem; color: var(--text); }
    footer { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 2rem; color: var(--muted); font-size: 0.85rem; }
    code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.88em; }
    .hero { break-inside: avoid; page-break-inside: avoid; }
    @media print {
      body {
        background: #fff;
        color: #111;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      header, main, footer { max-width: none; padding: 0.5rem 0; }
      .hero {
        border: 2px solid #243049 !important;
        background: #f4f7fc !important;
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .tile, .card, .finding, section {
        background: #fff !important;
        border-color: #ccc !important;
        break-inside: avoid;
      }
      details.tech { display: none; }
      footer { display: none; }
      a { color: inherit; text-decoration: none; }
    }
    @media screen and (max-width: 720px) {
      .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      header h1 { font-size: 1.4rem; }
    }
