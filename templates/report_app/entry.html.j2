{%- import "report/v2/_v2_primitives.html.j2" as prim -%}
{%- from "report/v2/_v2_capability_card.html.j2" import capability_constellation -%}
{#
  Bundle entry (report app v2) — the JS-rich renderer per DESIGN_V2.md.

  Consumes the shared report context (build_report_context); the signature
  opening binds ``opening`` (build_opening) when the parallel task has wired
  it in, and falls back to the model fields directly when it is absent, so
  every opening value stays data-driven with no literal numbers. The
  constellation macro call keeps its exact shared shape; the capability
  detail list is rendered here (progressive disclosure), and the technical
  ledger is rendered here with h3 headings (the shared technical partial is
  single-file-only, keeping exactly one h2 per section A-E).
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'" />
  <title>Security License Lens report</title>
  <style>
{% include "report/v2/_v2_styles.css.j2" %}
  </style>
  <link rel="stylesheet" href="{{ assets_dir }}/{{ css_name }}" />
</head>
<body>
  {#- Opening data, data-driven at every stage (no literal numbers). #}
  {%- set opening = opening or {} -%}
  {%- set o_tenant = opening.get('tenant_name') or result.tenant_display_name or result.tenant_id or 'demo / dry-run' -%}
  {%- set o_tenant_id = opening.get('tenant_id') if 'tenant_id' in opening else result.tenant_id -%}
  {%- set o_scanned = opening.get('scanned_at') or result.display_scanned_at -%}
  {%- set o_pct = opening.get('realized_percent') -%}
  {%- if o_pct is not number -%}{%- set o_pct = posture.realized_percent -%}{%- endif -%}
  {%- set o_pct = [0, [o_pct, 100] | min] | max -%}
  {%- set o_sentence = opening.get('realized_sentence') or posture.realized_sentence -%}
  {%- set mode_str = exec_copy["scan_mode"].get(result.scan_mode, result.scan_mode) -%}
  {%- if result.auth_mode and result.auth_mode != result.scan_mode -%}{%- set mode_str = mode_str ~ ' / ' ~ result.auth_mode -%}{%- endif -%}
  {%- set packs = result.packs_scanned | join(', ') -%}
  {%- set cwl = {} -%}
  {%- for e in constellation -%}
    {%- set _ = cwl.update({e.id: e.workload or 'general'}) -%}
  {%- endfor -%}

  <header class="app-header">
    <div class="app-header__bar">
      <div class="logo">
        {{ prim.lens_mark() }}
        <div class="logo__text">
          <h1>Security License Lens</h1>
          <p class="tagline">{{ tagline }}</p>
        </div>
      </div>
    </div>
    {% if result.warnings %}
    <div class="intro">
      <strong>Notes</strong>
      <ul style="margin: 0.5rem 0 0; padding-inline-start: 1.2rem;">
        {% for w in result.warnings %}
        <li>{{ w }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </header>

  <nav class="app-nav" aria-label="Report navigation" data-app-nav>
    <div class="app-nav__bar">
      <div class="app-nav__sections" data-section-nav>
        <a class="app-nav__link" href="#section-a" data-section-link="a" aria-current="true">Where you stand</a>
        <a class="app-nav__link" href="#section-c" data-section-link="c">What matters most</a>
        <a class="app-nav__link" href="#section-detection-realization" data-section-link="detection">Detection realization</a>
        <a class="app-nav__link" href="#section-b" data-section-link="b">What you're paying for</a>
        <a class="app-nav__link" href="#section-findings" data-section-link="findings">Findings</a>
      </div>
      <div class="app-nav__workloads" data-workload-nav role="group" aria-label="Workload navigation">
        <a class="workload-tab is-active" href="#findings" data-nav="all" aria-current="page">All</a>
      </div>
    </div>
  </nav>
  <div class="nav-sentinel" data-nav-sentinel aria-hidden="true"></div>

  <main class="app-main" id="main">
    <div class="app-main__content">
      {# A - Where you stand: the signature opening sequence, hierarchy-first. #}
      <section id="section-a" class="hero" aria-labelledby="a-title">
        <h2 id="a-title" class="sr-only">Where you stand</h2>
        <div class="opening">
          <div class="posture-figure" data-realized="{{ o_pct }}">
            <span class="posture-digits">{{ o_pct }}</span><span class="posture-unit">% realized</span>
          </div>

          <figure class="dist-figure" data-opening-stage="dist">
            <figcaption id="dist-title" class="sr-only">Operational distribution</figcaption>
            <div class="dist-bar" role="img" aria-labelledby="dist-title" aria-describedby="dist-desc">
              <span class="dist-segment dist-seg dist-seg--gap status-gap" style="flex-grow: {{ rollup.needs_attention }}; animation-delay: 160ms"></span>
              <span class="dist-segment dist-seg dist-seg--partial status-partial" style="flex-grow: {{ rollup.partly_set_up }}; animation-delay: 200ms"></span>
              <span class="dist-segment dist-seg dist-seg--ok status-ok" style="flex-grow: {{ rollup.fully_working }}; animation-delay: 240ms"></span>
              {% if rollup.you_own == 0 %}
              <span class="dist-seg dist-seg--empty" style="flex-grow: 1"></span>
              {% endif %}
            </div>
            <p id="dist-desc" class="sr-only">Operational distribution: {{ rollup.needs_attention }} action required, {{ rollup.partly_set_up }} incomplete, {{ rollup.fully_working }} operational{% if rollup.not_licensed > 0 %}, {{ rollup.not_licensed }} not licensed{% endif %}.</p>
            <table class="sr-only" data-dist-table>
              <caption>Operational distribution</caption>
              <thead>
                <tr><th scope="col">Status</th><th scope="col">Count</th></tr>
              </thead>
              <tbody>
                <tr><td>Action required</td><td>{{ rollup.needs_attention }}</td></tr>
                <tr><td>Incomplete</td><td>{{ rollup.partly_set_up }}</td></tr>
                <tr><td>Operational</td><td>{{ rollup.fully_working }}</td></tr>
                {% if rollup.not_licensed > 0 %}
                <tr><td>Not licensed</td><td>{{ rollup.not_licensed }}</td></tr>
                {% endif %}
              </tbody>
            </table>
          </figure>

          <p class="implication opening-implication" data-opening-stage="implication">{{ o_sentence.rstrip('.') }}.</p>

          <p class="hero-action" data-opening-stage="actions">
            <a href="#section-c">View prioritized actions</a>
          </p>

          <details class="tech how-we-got-here">
            <summary>
              <span class="caret" aria-hidden="true">▸</span>
              How we got here
            </summary>
            <div class="tech-body">
              <div class="posture-stat-strip stat-strip">
                <span class="stat-item">
                  <span class="metric-figure-secondary stat__num">{{ rollup.you_own }}</span>
                  <span class="label stat__label">You own</span>
                </span>
                <span class="stat-item">
                  <span class="metric-figure-secondary stat__num">{{ rollup.fully_working }}</span>
                  <span class="label stat__label">Met assessed criteria</span>
                </span>
                <span class="stat-item">
                  <span class="metric-figure-secondary stat__num">{{ rollup.needs_attention }}</span>
                  <span class="label stat__label">Action required</span>
                </span>
                <span class="stat-item">
                  <span class="metric-figure-secondary stat__num">{{ rollup.partly_set_up }}</span>
                  <span class="label stat__label">Partly set up</span>
                </span>
                <span class="stat-item">
                  <span class="metric-figure-secondary stat__num">{{ rollup.not_licensed }}</span>
                  <span class="label stat__label">Not licensed</span>
                </span>
              </div>
              <ul class="dist-items">
                <li class="dist-item status-gap">
                  {{ prim.status_marker('gap') }}
                  <span class="num dist-item__count">{{ rollup.needs_attention }}</span>
                </li>
                <li class="dist-item status-partial">
                  {{ prim.status_marker('partial') }}
                  <span class="num dist-item__count">{{ rollup.partly_set_up }}</span>
                </li>
                <li class="dist-item status-ok">
                  {{ prim.status_marker('ok') }}
                  <span class="num dist-item__count">{{ rollup.fully_working }}</span>
                </li>
                {% if rollup.not_licensed > 0 %}
                <li class="dist-item status-not_licensed">
                  {{ prim.status_marker('not_licensed') }}
                  <span class="num dist-item__count">{{ rollup.not_licensed }}</span>
                </li>
                {% endif %}
              </ul>
            </div>
          </details>
        </div>
      </section>

      {# B - What you're paying for #}
      {# C - What matters most: the prioritized top moves, a numbered sequence. #}
      <section id="section-c" data-reveal data-reveal-index="1" aria-labelledby="c-title">
        <p class="kicker">Priorities</p>
        <h2 id="c-title">What matters most</h2>
        <p class="section-help">
          Ranked by security impact, evidence confidence, and estimated effort.
        </p>
        {% if moves %}
        <ol class="move-list">
          {% for move in moves %}
          <li class="move-item" id="move-{{ loop.index }}">
            <span class="move-index mono" aria-hidden="true">{{ '%02d' | format(loop.index) }}</span>
            <div class="move-body">
              <div class="move-head">
                <strong class="move-title">{{ move.title }}</strong>
                {% if move.effort_label %}<span class="move-effort">{{ move.effort_label | lower }}</span>{% endif %}
              </div>
              {% if move.why %}<p class="move-why"><strong>Why:</strong> {{ move.why }}</p>{% endif %}
              {% if move.customer_next_step %}<p class="move-action"><strong>Action:</strong> {{ move.customer_next_step }}</p>{% endif %}
              {% if move.check_ids %}<p class="move-ids">Checks: <span class="mono">{{ move.check_ids | join(', ') }}</span></p>{% endif %}
              {% if move.deep_link %}<p class="move-link"><a href="{{ move.deep_link }}">Open the admin page</a></p>{% endif %}
            </div>
          </li>
          {% endfor %}
        </ol>
        <p class="move-note">Effort is a rough guide, not a quote.</p>
        {% else %}
        <p class="caption">No prioritized moves were produced by this scan.</p>
        {% endif %}
      </section>

      {% include "report/v2/_v2_detection_realization.html.j2" %}

      {# B - What you're paying for #}
      <section id="section-b" data-reveal data-reveal-index="2" aria-labelledby="b-title">
        <p class="kicker">Entitlements</p>
        <h2 id="b-title">What you're paying for</h2>
        <p class="section-help">
          Licensed controls mapped to detected Microsoft entitlements, grouped by workload.
        </p>
        {% if sku_strip %}
        <details class="tech sku-details sku-strip">
          <summary>
            <span class="caret" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></span>
            <h3 class="tech-title sku-title">Owned SKUs ({{ sku_strip | length }})</h3>
          </summary>
          <div class="tech-body">
            <div class="table-scroll" data-table-scroll>
              <table class="sku-table">
                <caption class="sr-only">Subscribed SKUs</caption>
                <thead>
                  <tr>
                    <th scope="col">SKU</th>
                    <th scope="col" class="num">Consumed</th>
                    <th scope="col" class="num">Prepaid</th>
                  </tr>
                </thead>
                <tbody>
                  {% for sku in sku_strip %}
                  <tr>
                    <td title="{{ sku.part_number }}">{{ sku.friendly_name }}</td>
                    <td class="num">{{ sku.consumed_units or 0 }}</td>
                    <td class="num">{{ sku.prepaid_units or '—' }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </details>
        {% endif %}
        <h3 class="tech-title">Your security capabilities</h3>
        {{ capability_constellation(constellation, workload_icon_urls=workload_icon_urls) }}
        {% if capabilities %}
        <div class="capability-list" data-capability-list>
          {% for card in capabilities %}
          {% set status = card.status or 'not_licensed' %}
          {% set wl = cwl.get(card.id, 'general') %}
          <article class="capability-row" data-capability="{{ card.id }}" data-status="{{ status }}" data-workload="{{ wl }}">
            <button type="button" class="capability-row__select" data-capability-select="{{ card.id }}" aria-pressed="false">
              {% if workload_icon_urls.get(wl) %}
              <img class="workload-icon" src="{{ workload_icon_urls[wl] }}" width="18" height="18" alt="" decoding="async" aria-hidden="true" />
              {% endif %}
              <span class="capability-row__name">{{ card.plain_name }}</span>
              {{ prim.status_marker(status) }}
            </button>
            {% if card.outcome %}
            {% set sentences = card.outcome.split('. ') %}
            <p class="capability-row__outcome">{{ sentences[0] }}{% if sentences | length > 1 and not sentences[0].endswith('.') %}.{% endif %}</p>
            {% endif %}
            <details class="tech">
              <summary>Why this capability matters</summary>
              <p><span class="label">Why it matters</span> {{ card.why_it_matters or 'Not reported' }}</p>
              {% if card.if_unused %}<p><span class="label">If left off</span> {{ card.if_unused }}</p>{% endif %}
              <div class="capability-row__provenance">
                {% if card.entitlement_kind == 'consumption' %}
                <div><span class="label">Observed in Azure</span> <span class="mono">{{ card.observed_resources | join(', ') or 'Azure resource' }}</span></div>
                {% else %}
                <div><span class="label">License</span> <span title="{{ card.matched_skus | join(', ') }}">{{ card.friendly_skus | join(', ') or 'Not reported' }}</span></div>
                {% endif %}
                <div><span class="label">Service plan</span> <span title="{{ card.matched_service_plans | join(', ') }}">{{ card.friendly_plans | join(', ') or 'No matching service plan reported' }}</span></div>
              </div>
            </details>
          </article>
          {% endfor %}
        </div>
        {% else %}
        <p class="caption">No licensed capabilities were resolved from entitlements.</p>
        {% endif %}
      </section>

      {# Findings — the merged D+E section: charts at a glance (collapsed),
         the explorer header (search, sort, filters, counts, exports), and
         one collapsed client-rendered row per finding. Expanding a row
         reveals the full belief block (the former section D content). #}
      <section id="section-findings" class="findings-section" data-reveal data-reveal-index="3" aria-labelledby="e-title">
        <p class="kicker">Findings</p>
        <h2 id="e-title">Findings</h2>
        <p class="section-help">
          Every assessed control, most critical first. Expand a row for what we
          expected, what we observed, and what to do next. Select several values in a
          group to match any of them; different groups combine. Filter by compliance
          mappings (Mapped / Unmapped) to isolate controls with NIST or MITRE
          references.
        </p>

        <details class="tech findings-charts">
          <summary>
            <span class="caret" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></span>
            Findings at a glance
          </summary>
          <div class="tech-body">
            <div class="charts" data-charts></div>
            <p class="section-help">
              Distribution of findings by status, workload, confidence, and evaluation mode.
              Each chart has an equivalent data table for assistive technology.
            </p>
          </div>
        </details>

        <div class="d-filter-status" data-d-filter-status role="status" aria-live="polite"></div>

        <div class="findings-head">
          <span class="filter-count" role="status" aria-live="polite" aria-atomic="true">
            Showing <strong data-visible-count>0</strong> of <strong data-total-count>0</strong>
          </span>
        </div>

        <div class="search-box">
          <label class="search-box__label" for="finding-search">Search findings</label>
          <input id="finding-search" class="search-box__input" type="search"
                 placeholder="Search titles, checks, evidence" autocomplete="off" spellcheck="false" />
        </div>

        <div class="sort-box">
          <label class="search-box__label" for="finding-sort">Sort findings</label>
          <select id="finding-sort" class="sort-box__select">
            <option value="severity" selected>Severity (default)</option>
            <option value="impact">Impact</option>
            <option value="effort">Effort</option>
            <option value="title">Title A–Z</option>
          </select>
        </div>

        <div class="filter-bar" data-filter-bar></div>

        <div class="findings-tools">
          <button type="button" data-export="json">Export JSON</button>
          <button type="button" data-export="csv">Export CSV</button>
          <button type="button" data-print>Print</button>
        </div>

        <div class="findings-list" id="findings" data-findings-list></div>

        <p class="empty-state" data-empty-state hidden></p>

        <nav class="pagination" data-pagination aria-label="Pagination" hidden></nav>

        <div class="print-list" data-print-list></div>

        {#- Technical ledger: h3 headings keep the h1 -> h2 -> h3 tree intact. #}
        <details class="tech app-tech">
          <summary>
            <span class="caret" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></span>
            Technical details (product names, SKUs, check IDs)
          </summary>
          {% if result.subscribed_skus %}
          <h3>Subscribed SKUs</h3>
          <div class="table-scroll" data-table-scroll>
            <table>
              <thead>
                <tr>
                  <th scope="col">Part number</th>
                  <th scope="col">Status</th>
                  <th scope="col">Units</th>
                  <th scope="col">Service plans</th>
                </tr>
              </thead>
              <tbody>
                {% for sku in result.subscribed_skus %}
                <tr>
                  <td><code>{{ sku.sku_part_number }}</code></td>
                  <td>{{ sku.capability_status or "—" }}</td>
                  <td>{{ sku.consumed_units or 0 }} / {{ sku.prepaid_units or "—" }}</td>
                  <td>{{ sku.service_plans | map(attribute='service_plan_name') | join(', ') }}</td>
                </tr>
                {% else %}
                <tr><td colspan="4" style="color: var(--text-2);">No SKUs collected.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% endif %}

          <h3>Finding reference table</h3>
          <div class="table-scroll" data-table-scroll>
            <table>
              <thead>
                <tr>
                  <th scope="col">Status</th>
                  <th scope="col">Check ID</th>
                  <th scope="col">Technical title</th>
                  <th scope="col">Workload</th>
                  <th scope="col">Severity</th>
                  <th scope="col">Confidence</th>
                  <th scope="col">Evaluation mode</th>
                </tr>
              </thead>
              <tbody>
                {% for f in findings %}
                <tr>
                  <td>{{ prim.status_marker(f["status"]) }}</td>
                  <td><code>{{ f["check_id"] }}</code></td>
                  <td>{{ f["title"] }}</td>
                  <td>{% if f["workload"] %}{{ f["workload"] }}{% else %}—{% endif %}</td>
                  <td>{% if f["severity"] %}{{ f["severity"] }}{% else %}—{% endif %}</td>
                  <td>{{ f["confidence_label"] or "—" }}</td>
                  <td>{% if f["evaluation_mode"] %}{{ f["evaluation_mode"] }}{% else %}—{% endif %}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </details>
      </section>
    </div>
  </main>

  <footer class="report-footer">
    <div class="report-footer__grid">
      <div class="report-footer__block">
        <h2 class="report-footer__heading">Evidence modes</h2>
        <ul class="report-footer__legend">
          {%- for entry in provenance.mode_legend %}
          <li>{{ entry.label }}</li>
          {%- else %}
          <li>No findings evaluated in this scan.</li>
          {%- endfor %}
        </ul>
        <p class="report-footer__method">{{ provenance.methodology }}</p>
      </div>
      <div class="report-footer__block">
        <h2 class="report-footer__heading">Coverage</h2>
        <p class="report-footer__coverage">{{ provenance.sampling.text }}</p>
      </div>
    </div>
    <p class="report-footer__identity"><span class="report-footer__name">{{ provenance.identity.name }}</span> <span aria-hidden="true">&mdash;</span> generated <time datetime="{{ provenance.identity.scanned_at }}">{{ provenance.identity.display_scanned_at }}</time></p>
    <p class="meta">
      <span class="meta-row">Version {{ result.version }}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="meta-row">Scanned <time class="mono" datetime="{{ opening.get('scanned_at') or result.scanned_at }}">{{ o_scanned }}</time></span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="meta-row">Mode {{ mode_str }}</span>
      {% if result.tenant_display_name %}
      <span class="sep" aria-hidden="true">·</span>
      <span class="meta-row">Organization {{ o_tenant }}</span>
      {% endif %}
      {% if packs %}
      <span class="sep" aria-hidden="true">·</span>
      <span class="meta-row">{{ packs }} priority packs</span>
      {% endif %}
    </p>
    <p class="report-footer__tagline">{{ tagline }} &mdash; read-only advisory, review before acting. Not affiliated with Microsoft.</p>
  </footer>

  <script src="{{ assets_dir }}/{{ data_name }}"></script>
  <script src="{{ assets_dir }}/{{ js_name }}"></script>
</body>
</html>
