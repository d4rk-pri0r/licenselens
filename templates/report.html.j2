{%- import "report/_primitives.html.j2" as prim -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Security License Lens report</title>
  <style>
{% include "report/_styles.css.j2" %}
  </style>
</head>
<body>
  <header>
    <div class="logo">
      <div class="logo-mark"></div>
      <div>
        <h1>Security License Lens</h1>
        <p class="tagline">{{ tagline }}</p>
      </div>
    </div>
    <div class="meta">
      {{ prim.meta_row("Version", result.version) }}
      {{ prim.meta_row("Scanned", result.display_scanned_at) }}
      {% set mode_str = result.scan_mode %}{% if result.auth_mode and result.auth_mode != result.scan_mode %}{% set mode_str = mode_str ~ ' / ' ~ result.auth_mode %}{% endif %}{{ prim.meta_row("Mode", mode_str) }}
      {{ prim.meta_row("Organization", result.tenant_display_name or result.tenant_id or "demo / dry-run") }}
    </div>
    {% if result.warnings %}
    <div class="intro" style="border-color: color-mix(in srgb, var(--state-incomplete) 40%, var(--border));">
      <strong>Notes</strong>
      <ul style="margin: 0.5rem 0 0; padding-left: 1.2rem;">
        {% for w in result.warnings %}
        <li>{{ w }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </header>

    <main>
    {% set rollup = result.capability_rollup %}
    <section class="hero">
      <h2>Your security at a glance</h2>
      <div class="summary-grid">
        <div class="summary-posture">
          <div class="posture-figure">{{ rollup.realized_percent }}% realized</div>
          <p class="posture-sentence">{{ rollup.realized_sentence }}.</p>
        </div>
        <div class="summary-action">
          <div class="n">{{ rollup.needs_attention + rollup.partly_set_up }}</div>
          <div class="l">Need attention</div>
          <small>of {{ rollup.you_own }} prioritized capabilities</small>
        </div>
        <div class="summary-metrics">
          <div class="metric-row">
            <span class="n">{{ result.owned_capabilities | length }}</span>
            <span class="metric-text"><span class="metric-label">Licensed capabilities detected</span><small>across all detected licenses</small></span>
          </div>
          <div class="metric-row">
            <span class="n">{{ rollup.you_own }}</span>
            <span class="metric-text"><span class="metric-label">Prioritized capabilities</span><small>{{ result.packs_scanned | join(', ') }} priority packs</small></span>
          </div>
          <div class="metric-row">
            <span class="n">{{ rollup.fully_working }}</span>
            <span class="metric-text"><span class="metric-label">Fully working</span></span>
          </div>
        </div>
        {% if result.has_exposed %}
        <div class="critical-rail" data-critical-rail>
          <span class="critical-rail-label">{{ exposure_labels['exposed'] }}</span>
          <span class="critical-rail-titles">{% for f in findings if f.check_id in result.exposed_check_ids %}{{ f.display_customer_title }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
        </div>
        {% endif %}
      </div>
    </section>

    <details class="tech" style="margin-bottom: 1rem;">
      <summary>How to read this report</summary>
      <p style="margin: 0.5rem 0 0; color: var(--text-1); font-size: 0.92rem;">
        Microsoft licenses often include powerful protections with confusing product names.
        Below we translate those into everyday outcomes, then show where setup still looks incomplete.
        Product names and technical IDs are available in each finding's evidence and the technical section at the bottom.
      </p>
    </details>

    <div class="tiles">
      {% for status in status_order %}
      <div class="tile">
        <div class="n">{{ counts.get(status, 0) }}</div>
        <div class="l">
          {{ prim.PRESENTATION.get(status, status) }}
          <small>{{ status }}</small>
        </div>
      </div>
      {% endfor %}
    </div>

    <section>
      <h2>What you already pay for</h2>
      <p class="section-help">
        These are protections included in the licenses we detected — described by what they do for your business, with licensing details shown beneath each card.
      </p>
{% include "report/_capability_card.html.j2" %}
    </section>

{% include "report/_finding_card.html.j2" %}

{% include "report/_technical.html.j2" %}
  </main>

  <footer>
    {{ tagline }} &mdash; read-only advisory, review before acting. Not affiliated with Microsoft.
  </footer>
  <script>
{% include "report/_filters.js.j2" %}
  </script>
</body>
</html>
